# Somente URL do projeto confirmado e chave pública; sem valores reais neste arquivo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alias compatível com a chave anon local e o workflow futuro de Pages.
VITE_SUPABASE_ANON_KEY=
# URL HTTPS exata, aprovada, sem credenciais, query ou fragmento. Não derivar do referrer.
VITE_FLW_RETURN_URL=
# Testes exclusivamente locais, no processo Node. NUNCA prefixar com VITE_.
LOCAL_STACK_ENV_FILE=
# Sem SMTP local: envio de convite Auth é tarefa administrativa pendente.
# Chaves service_role e JWT secret ficam exclusivamente no cofre/servidor.
# db-reset e geração de tipos usam somente zetta em localhost:54322.

# Somente Edge Function/servidor (nunca VITE_*); configure via secrets no projeto confirmado.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=https://seu-dominio/zetta-estetica
# APP_ORIGIN=https://seu-dominio
# SMTP: somente secrets do servidor/CLI, nunca VITE_*.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=
# SMTP_SENDER_NAME=
# Homologação opcional de WebKit/iPhone em Playwright (exige bibliotecas do SO).
# PLAYWRIGHT_IOS=1
# FLW Prompt 04: nenhum endpoint/segredo FLW habilitado. Não configurar token no frontend.
# flw-adapter usa os secrets SUPABASE_* e APP_ORIGIN acima, somente no servidor.
# tenant_integrations.secret_ref reserva uma referência ao cofre; não armazena o segredo.
