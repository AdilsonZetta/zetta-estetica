{
  "name": "zetta-estetica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/lab.test.ts tests/public-key.test.ts tests/context.test.ts",
    "test:api": "node --test tests/auth-api.test.mjs tests/foundation-api.test.mjs tests/console-api.test.mjs tests/launch-api.test.mjs tests/flw-api.test.mjs tests/clients-api.test.mjs tests/catalog-api.test.mjs",
    "test:e2e": "playwright test",
    "db:reset": "bash scripts/db-reset.sh",
    "db:seed": "node scripts/seed-local.mjs",
    "db:types": "node scripts/generate-types.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:concurrency": "node --test tests/foundation-concurrency.test.mjs tests/console-concurrency.test.mjs tests/flw-concurrency.test.mjs tests/clients-concurrency.test.mjs tests/catalog-concurrency.test.mjs",
    "test:edge": "deno test supabase/functions/invitation-delivery/handler.test.ts supabase/functions/flw-adapter/handler.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.90.0",
    "supabase": "^3.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
